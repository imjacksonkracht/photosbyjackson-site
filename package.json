{
  "name": "photosbyjackson-site",
  "private": true,
  "description": "Photos by Jackson — portfolio and booking site.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "photos": "node scripts/process-photos.mjs",
    "test": "playwright test tests/site.spec.ts",
    "test:ui": "playwright test --ui",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "report": "playwright show-report",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production"
  },
  "dependencies": {
    "motion": "14.1.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "exifr": "7.1.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.149.0"
  }
}
