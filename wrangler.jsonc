{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Default environment: the preview Worker. `npm run cf:deploy` targets it.
  // It is served on workers.dev only and has no routes or custom domains.
  "name": "photosbyjackson-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // Not secret. RESEND_API_KEY is set with `wrangler secret put`.
    "CONTACT_FROM_EMAIL": "Photos by Jackson <inquiries@send.jacksonkracht.com>",
    "CONTACT_TO_EMAIL": "jackson@photosbyjackson.org"
  },

  "env": {
    // Production Worker: `npm run cf:deploy:production`.
    // Custom domains are attached separately at cutover (see docs/LAUNCH.md),
    // so deploying this never changes photosbyjackson.org on its own.
    "production": {
      "name": "photosbyjackson",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true },
      // vars are not inherited between environments.
      "vars": {
        "CONTACT_FROM_EMAIL": "Photos by Jackson <inquiries@send.jacksonkracht.com>",
        "CONTACT_TO_EMAIL": "jackson@photosbyjackson.org"
      }
    }
  }
}
